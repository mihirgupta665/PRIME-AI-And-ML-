import numpy as np



arr1 =np.array([1,2,3,4,5])


print(arr1)








import time
size = 10_000_000
py_list = list(range(size))  # creates a list of specified range

start1 = time.time()
sq_list = [val**2 for val in py_list]    # list comprehension has expression in beginning
end1 = time.time()
print(f"Total time for Squaring Python List is : {end1-start1}")

np_arr = np.array(py_list)  # its takse a parameter list and converts it into array capable of vectorization
start2 = time.time()
sq_arr = np_arr ** 2 
end2 = time.time()
print(f"Total time for Squaring Numpy Array is : {end2-start2}")





import sys

list_size = sys.getsizeof(py_list) 
elements_size = sum(sys.getsizeof(x) for x in py_list)
total_size = list_size + elements_size
print(f"Size of py_list is : {total_size}")

print(f"Size of nb_array is : {np_arr.nbytes}")





arr1 =np.array([1,2,3,4,5, "Prime"])
print(arr1)
print(f"Type is {arr1.dtype} And Shape : {arr1.shape} ")





# zeros((row, col) dtype="type") : (r, c) is used to define the shape and dtype is used to define the datatype of each element
arr_zeros = np.zeros((2,3), dtype="int64")    # np.zeros(), np.ones() :is used to create a array
print(arr_zeros)
print(f"The dtype is : {arr_zeros.dtype} And the Shape is : {arr_zeros.shape}")



arr_ones = np.ones((5,))    # by default the type is floating And (row,) : is used to define One-Dimentional array 
print(arr_ones)


arr_full = np.full((3,4), 101)    # np.full((r,c), value)   -> value becomes the each element of array
print(arr_full)


arr_eye = np.eye(3, dtype="int64")   # np.eye(size) : Creates a identity matrics of specified size
print(arr_eye)
print(f"Array Shape is : {arr_eye.shape}")



# arange(start, end, step) : creates a 1-D Array of range form start to one less than end and for each element at the specified step 
arr_arange = np.arange(3, 25, 2)
print(arr_arange)
print(f"Array Shape is : {arr_arange.shape}")


arr_linspace = np.linspace(1,100,4)
print(arr_linspace)



