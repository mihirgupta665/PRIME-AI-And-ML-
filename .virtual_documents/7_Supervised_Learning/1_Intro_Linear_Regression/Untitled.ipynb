


class LinearRegressionOLS:
    def __init__(self,):
        self.bias = None
        self.weights = None

    def fit(self, X, y):
        m,n = X.shape
        
        X_b = n.c_[np.ones((m,1)), X]
        # normal equation
        theta = np.dot( np.linalg.inv(np.dot(X_b.T, X_b)), np.dot(X_b.T, y) )

        self.bias = theta[0]
        self.weights = theta[1:]

    def predict(self, X):
        y_pred = self.bias + np.dot(X, self.weights)



