import numpy as np
import pandas as pd
import seaborn as sns


X = np.array([[1,2],[2,3],[3,3],[6,5],[7,7]])
y = np.array([0,0,0,1,1])

test = np.array([[2,2],[6,6]])

data = pd.DataFrame(X, columns=["x1", "x2"])   # columns name(title) are given like this
data["label"] = y
data


test = pd.DataFrame(test, columns=["x1", "x2"] )
test
# direct data is passed and x an y could be passed as column legend and hue is passed as label
sns.scatterplot(data=data, x="x1", y="x2", hue="label")
sns.scatterplot(data=test, x="x1", y="x2", color="black", marker="X", label="Test Points")






