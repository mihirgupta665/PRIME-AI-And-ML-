import os
os.environ["OMP_NUM_THREADS"] = "1"


import seaborn as sns
from sklearn.datasets import load_iris
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
import pandas as pd


iris = load_iris()
iris


# X= pd.DataFrame(iris.data)
X=iris.data
y= iris.target


# X.columns = iris.feature_names
print(X.shape)
X


sns.scatterplot(x=X[:,0], y=X[:,2], c=y)


scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
X_scaled


from sklearn.decomposition import PCA
pca = PCA(n_components=2)
X_pca_data = pca.fit_transform(X_scaled)
X_pca_data


# Elbow K
wcss = []
for k in range(1,11):
    kmeans = KMeans(
        n_clusters=k,
        # random_state=42
    )
    kmeans.fit(X_pca_data)
    wcss.append(kmeans.inertia_)
    


sns.lineplot(x=range(1,11), y=wcss, marker="o")


kmeans = KMeans(
    n_clusters=3,
)
labels = kmeans.fit_predict(X_pca_data)


sns.scatterplot(x=X_pca_data[:,0], y=X_pca_data[:,1], c=labels)
sns.scatterplot(x=kmeans.cluster_centers_[:,0], y=kmeans.cluster_centers_[:,1], marker="X", c="red", s=150)


sns.scatterplot(x=X_pca_data[:,0], y=X_pca_data[:,1], c=y)



