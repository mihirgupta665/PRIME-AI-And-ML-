





import os 
os.environ["OMP_NUM_THREADS"] = "9"


import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from sklearn.preprocessing import OneHotEncoder, StandardScaler
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans, AgglomerativeClustering
from sklearn.metrics import silhouette_score
from kneed import KneeLocator
# import sklearn.preprocessing


df = pd.read_csv("smartcart_customers.csv")
df


print(f"Shape : {df.shape}")
df.info


df.isnull().sum()





df["Income"] = df["Income"].fillna(df["Income"].mean())
df["Income"].isnull().sum()


# Customer Joining Date
df["Dt_Customer"] = pd.to_datetime(df["Dt_Customer"], dayfirst=True)

reference = df["Dt_Customer"].max()
print("Reference :", reference)

max_year = reference.year
print(f"Max Year : {max_year}")

df["Customer_Tenure_Days"] = ( reference - df["Dt_Customer"]).dt.days


# Age
df["Age"] = max_year - df["Year_Birth"]


df.head()


df["Total_Spending"] = df["MntWines"] + df["MntFruits"] + df["MntMeatProducts"] + df["MntFishProducts"] + df["MntSweetProducts"] + df["MntGoldProds"] 


df.head()


df["Education"].value_counts()


df["Education"] = df["Education"].replace({
    "2n Cycle": "Undergraduate",
    "Basic": "Undergraduate",
    "Graduation": "Graduate",
    "PhD": "Postgraduate",
    "Master": "Postgraduate"    
})

df["Education"].value_counts()


df.columns


df["Living_With"] = df["Marital_Status"].replace({
    "Married":"Partner",
    "Together":"Partner",
    "Single":"Alone",
    "Divorced":"Alone",
    "Widow":"Alone",
    "YOLO":"Alone",
    "Absurd":"Alone"
})

df["Living_With"].value_counts()


df.head()


df.shape


df.columns


drop_cols = ["ID", "Year_Birth", "Marital_Status", "Dt_Customer", "MntWines", "MntFruits", "MntMeatProducts", "MntFishProducts", "MntSweetProducts", "MntGoldProds"]
df_cleaned = df.drop(columns=drop_cols)


df_cleaned.head()


cols = [ "Income", "Recency", "Age", "Total_Spending", "Kidhome"]

# relative plots of some features - pair plots
sns.pairplot(df_cleaned[cols])


print(f"Dataset with outlier : {len(df_cleaned)}")

df_cleaned = df_cleaned[ (df_cleaned["Income"] < 600_000) ]
df_cleaned = df_cleaned[ (df_cleaned["Age"] < 90) ]

print(f"Dataset after outlier removal : {len(df_cleaned)}")



# Correlation Matrix
corr = df_cleaned.corr(numeric_only=True)

plt.figure(figsize=(10,6))

sns.heatmap(
    corr,
    annot=True,
    annot_kws={"size":6},
    cmap="coolwarm",
)

plt.tight_layout()


# OneHotEncoding
ohe = OneHotEncoder()
cat_cols = ["Education", "Living_With"]
enc_cols = ohe.fit_transform(df_cleaned[cat_cols])
enc_cols


df[cat_cols].head()


ohe.get_feature_names_out(cat_cols)


df_enc = pd.DataFrame(enc_cols.toarray(), columns=ohe.get_feature_names_out(cat_cols), index=df_cleaned.index)
df_enc


df_encoded = pd.concat([df_cleaned.drop(columns=cat_cols), df_enc], axis=1)
df_encoded.head()


X = df_encoded
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
print(X_scaled.shape)
X_scaled


pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)
# print(f"PCA Components : {pca.components}")
print(f"PCA explain : {pca.explained_variance_ratio_}")


sns.scatterplot(x=X_pca[:,0], y=X_pca[:,1])


pca = PCA(n_components=3)
X_pca = pca.fit_transform(X_scaled)
pca.explained_variance_ratio_


fig = plt.figure(figsize=(10,6))
ax = fig.add_subplot(111, projection="3d")
ax.scatter(X_pca[:,0], X_pca[:,1], X_pca[:,2])
ax.set_xlabel("PCA1")
ax.set_ylabel("PCA2")
ax.set_zlabel("PCA3")
ax.set_title("3D Projection")
plt.tight_layout()


wcss = []
for k in range(1,11):
    kmeans = KMeans(n_clusters=k, random_state=42)
    kmeans.fit_predict(X_pca)
    wcss.append(kmeans.inertia_)

wcss


plt.plot(range(1,11), wcss, marker="o")
plt.xlabel("K -->")
plt.ylabel("WCSS -->")
plt.title("Knee Locator Graph")
plt.tight_layout()


knee = KneeLocator(range(1,11), wcss, curve="convex", direction="decreasing")
print(f" Best K value : {knee.elbow}")


# Silhouette Score

scores = []

for k in range(2,11):
    kmeans = KMeans(n_clusters = k, random_state=42)
    labels = kmeans.fit_predict(X_pca)
    score = silhouette_score(X_pca, labels)
    scores.append(score)
    
scores


plt.plot(range(2,11), scores, marker="o")
plt.xlabel("K -->")
plt.ylabel("Scores -->")
plt.title("Silhouette Score Graph")
plt.tight_layout()


# ploting Both Elbow and Silhouette Score Together

k_range = range(2,11)
fig, ax1 = plt.subplots(figsize=(8,6))
ax1.plot(k_range, wcss[1:], color="blue", marker="o")
ax1.set_xlabel("K Values")
ax1.set_ylabel("WCSS Values")

ax2 = ax1.twinx()
ax2.plot(k_range, scores, color="red", marker="x", linestyle="--")
ax.set_ylabel("Silhouette Score")


# K-Means Clustering
kmeans = KMeans(n_clusters=4, random_state=42)
labels = kmeans.fit_predict(X_pca)


fig = plt.figure(figsize=(8,6))
ax = fig.add_subplot(111, projection="3d")
ax.scatter(X_pca[:, 0], X_pca[:, 1], X_pca[:, 2], c=labels)


agg_clf = AgglomerativeClustering(n_clusters=4, linkage="ward")
agg_labels = agg_clf.fit_predict(X_pca)


fig = plt.figure(figsize=(8,6))
aw = fig.add_subplots(111, "3d")
aw.scatter(X_pca[:,0], X_pca[:,1], X_pca[:,2], c=agg_labels)



